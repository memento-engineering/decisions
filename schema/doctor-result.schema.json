{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/memento-engineering/decisions/schema/doctor-result.schema.json",
  "title": "decisions doctor result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "supportedSpec",
    "register",
    "worst",
    "exitCode",
    "findings"
  ],
  "definitions": {
    "severity": { "enum": ["info", "ok", "warn", "fail"] }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "minLength": 1 },
    "supportedSpec": { "type": "integer", "minimum": 1 },
    "register": { "type": ["string", "null"] },
    "worst": { "$ref": "#/definitions/severity" },
    "exitCode": { "enum": [0, 1, 2] },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "severity", "message", "hint"],
        "properties": {
          "check": {
            "enum": ["binary", "register", "spec", "parse", "style", "skills"]
          },
          "severity": { "$ref": "#/definitions/severity" },
          "message": { "type": "string", "minLength": 1 },
          "hint": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    }
  }
}
