{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/memento-engineering/decisions/schema/lint-result.schema.json",
  "title": "decisions lint result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "register", "valid", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "register": { "type": "string" },
    "valid": { "type": "boolean" },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "file", "message"],
        "properties": {
          "ruleId": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
